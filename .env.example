# Pra rodar via Docker Compose (sobe Postgres em container):
COMPOSE_PROFILES=dev
DB_HOST=db

# Pra rodar conectando em Postgres externo (RDS, Postgres local nativo, etc),
# remova COMPOSE_PROFILES e ajuste DB_HOST pro endereço do banco.

PORT=3000

DB_PORT=5432
DB_NAME=primedesk
DB_USER=postgres
DB_PASSWORD=sua_senha

JWT_SECRET=troque_por_uma_chave_secreta_forte
